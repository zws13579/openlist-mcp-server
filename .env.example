# OpenList MCP Server 配置示例
# 复制此文件为 .env 并填入实际参数：cp .env.example .env

# 服务端地址：支持 http:// 或 https://（如公网域名 https://pan.yourdomain.com 或本地 http://localhost:5244）
OPENLIST_URL=http://localhost:5244

# 认证方式 1：用户名与密码（自动登录并换取 Token）
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=your_password_here

# 认证方式 2（推荐用于公网云端）：直接使用后台生成的静态 API Token（优先级高于用户名密码）
# OPENLIST_TOKEN=your_token_here

# 可选：生产级安全控制
# OPENLIST_READONLY=false
# OPENLIST_ALLOWED_PATHS=/public,/workspace
# OPENLIST_CONFIRM_REMOVE=false

# 可选：网络连接高级选项（如内网使用自签名 HTTPS 证书，可设为 true 跳过证书校验）
# OPENLIST_INSECURE_SSL=false
